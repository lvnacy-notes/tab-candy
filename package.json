{
	"name": "tabcandy",
	"version": "2.0.0",
	"description": "A plugin for Obsidian. Create customizable new tab views with backgrounds, quotes, search, and more.",
	"main": "dist/main.js",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node esbuild.config.js",
		"dev:mobile": "node esbuild.config.js --mobile",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"typecheck:fast": "tsgo --noEmit --skipLibCheck",
		"lint": "eslint .",
		"build": "pnpm run typecheck && node esbuild.config.js production",
		"version": "node version-bump.js && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Andrew McGivery",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@eslint/json": "0.14.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@types/node": "^24.9.2",
		"@types/react": "^18.3.9",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "^8.68.0",
		"@typescript-eslint/parser": "^8.68.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.13.1",
		"sass-embedded": "^1.103.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0"
	},
	"dependencies": {
		"esbuild-copy-static-files": "^0.1.0",
		"esbuild-sass-plugin": "^3.7.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	}
}